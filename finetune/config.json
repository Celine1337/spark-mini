{
  "base_model": "Qwen/Qwen2.5-Coder-1.5B-Instruct",
  "output_dir": "spark-lora",
  "lora": {
    "r": 16,
    "alpha": 32,
    "dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]
  },
  "train": {
    "epochs": 2,
    "lr": 0.0002,
    "batch_size": 2,
    "grad_accum": 8,
    "max_len": 1024,
    "warmup_ratio": 0.03,
    "val_split": 0.05
  },
  "quantize_4bit": true
}